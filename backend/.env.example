PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
# Cloudflare quick tunnel URL, e.g. https://xxxx.trycloudflare.com
PUBLIC_BASE_URL=
# Verify X-Plivo-Signature-V3 on callbacks (set false only if it misbehaves)
PLIVO_VERIFY_SIGNATURES=true
DEFAULT_TO_NUMBER=
# Comma-separated numbers verified on the Plivo trial account
VERIFIED_NUMBERS=
DEEPGRAM_API_KEY=
# LLM_PROVIDER: openrouter | google
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
DB_PATH=recovery.db
# TURN relay for "Talk in browser" on hosts without inbound UDP (Render). Either Cloudflare Realtime TURN:
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# ...or a static JSON list: [{"urls": "turn:host:3478", "username": "u", "credential": "p"}]
ICE_SERVERS=
# LiveKit Cloud (free Build plan): when all three are set, "Talk in browser" goes through a LiveKit room,
# which works on hosts without inbound UDP (Render). Leave empty to use the direct WebRTC path.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Small hosts: LOG_LEVEL=INFO and SMART_TURN=false cut CPU (Render free has 0.15 CPU)
LOG_LEVEL=DEBUG
SMART_TURN=true
